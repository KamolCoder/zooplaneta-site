# --- required in production ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=zooplaneta.uz,www.zooplaneta.uz
CSRF_TRUSTED_ORIGINS=https://zooplaneta.uz,https://www.zooplaneta.uz
SITE_URL=https://zooplaneta.uz

# Database: SQLite. In Docker the path is preset to /app/data/db.sqlite3 (host: $ZP_DATA_DIR/data).
# SQLITE_PATH=/app/data/db.sqlite3
# BACKUP_KEEP=14

# CMS address (default cms/) — use a less obvious path in production
ADMIN_URL=cms/

# notifications about new applications (optional)
LEADS_NOTIFY_EMAILS=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=site@zooplaneta.uz
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# map tiles (optional)
# MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
